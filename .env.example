# Example Environment Configuration for C-PrIM (Counterfactual Learning Path)
# Copy this file to .env and modify with your local deployment configurations.
# NOTE: Never commit sensitive credentials or live tokens to version control.

# Application Environment (development, testing, staging, production)
CFLP_ENV=development

# Server Configuration
CFLP_HOST=127.0.0.1
CFLP_PORT=8000
CFLP_DEBUG=False

# Model Artifacts and Execution
CFLP_DATA_DIR=data
CFLP_ARTIFACTS_DIR=artifacts
CFLP_REPORTS_DIR=reports
CFLP_DEFAULT_SEED=42
